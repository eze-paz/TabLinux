#!/usr/bin/env python3
"""Generate a proper FDT/DTB for RISC-V virt machine for Linux boot."""
import struct, sys

def pad4(n):
    return (n + 3) & ~3

class FdtBuilder:
    def __init__(self):
        self.struct = b''
        self.strings = b''
        self.strtab = {}
        self.rsvmap = [(0, 0)]
        self._next_phandle = 1

    def alloc_phandle(self):
        p = self._next_phandle
        self._next_phandle += 1
        return p

    def _add_string(self, s):
        if s not in self.strtab:
            self.strtab[s] = len(self.strings)
            self.strings += s.encode('ascii') + b'\x00'
        return self.strtab[s]

    def begin_node(self, name):
        self.struct += struct.pack('>I', 1) + name.encode('ascii') + b'\x00'
        self.struct += b'\x00' * (pad4(len(name) + 1) - (len(name) + 1))

    def end_node(self):
        self.struct += struct.pack('>I', 2)

    def prop(self, name, data):
        nameoff = self._add_string(name)
        self.struct += struct.pack('>III', 3, len(data), nameoff) + data
        self.struct += b'\x00' * (pad4(len(data)) - len(data))

    def end(self):
        self.struct += struct.pack('>I', 9)

    def build(self):
        header_size = 40
        rsvmap_offset = header_size
        rsvmap_size = len(self.rsvmap) * 16
        struct_offset = rsvmap_offset + rsvmap_size
        struct_offset = pad4(struct_offset)
        strings_offset = struct_offset + pad4(len(self.struct))
        totalsize = strings_offset + pad4(len(self.strings))

        header = struct.pack('>IIIIIIIIII',
            0xd00dfeed, totalsize, struct_offset, strings_offset,
            rsvmap_offset, 17, 16, 0, len(self.strings), len(self.struct))
        rsvmap_data = b''.join(struct.pack('>QQ', addr, size) for addr, size in self.rsvmap)
        return (header + rsvmap_data + self.struct
                + b'\x00' * (pad4(len(self.struct)) - len(self.struct))
                + self.strings
                + b'\x00' * (pad4(len(self.strings)) - len(self.strings)))

def build_virt_dtb(dram_base=0x8000_0000, dram_size=0x4000_0000,
                   initrd_start=0, initrd_end=0,
                   bootargs="console=hvc0 earlycon=sbi rdinit=/sbin/init"):
    fdt = FdtBuilder()
    fdt.begin_node('')
    fdt.prop('compatible', b'riscv-virtio')
    fdt.prop('model', b'riscv-virtio,qemu')
    fdt.prop('#address-cells', struct.pack('>I', 2))
    fdt.prop('#size-cells', struct.pack('>I', 2))

    fdt.begin_node('chosen')
    if bootargs:
        fdt.prop('bootargs', bootargs.encode('ascii') + b'\x00')
    if initrd_start and initrd_end:
        fdt.prop('linux,initrd-start', struct.pack('>II',
            (initrd_start >> 32) & 0xffffffff, initrd_start & 0xffffffff))
        fdt.prop('linux,initrd-end', struct.pack('>II',
            (initrd_end >> 32) & 0xffffffff, initrd_end & 0xffffffff))
    fdt.prop('stdout-path', b'/soc/serial@10000000')
    fdt.end_node()

    fdt.begin_node('cpus')
    fdt.prop('#address-cells', struct.pack('>I', 1))
    fdt.prop('#size-cells', struct.pack('>I', 0))
    fdt.prop('timebase-frequency', struct.pack('>I', 10000000))

    cpu_phandle = fdt.alloc_phandle()
    fdt.begin_node('cpu@0')
    fdt.prop('phandle', struct.pack('>I', cpu_phandle))
    fdt.prop('device_type', b'cpu')
    fdt.prop('reg', struct.pack('>I', 0))
    fdt.prop('status', b'okay')
    fdt.prop('compatible', b'riscv')
    fdt.prop('riscv,isa', b'rv64imafdc_zicsr_zifencei')
    fdt.prop('mmu-type', b'sv39')
    fdt.prop('clock-frequency', struct.pack('>I', 1000000000))

    fdt.begin_node('interrupt-controller')
    intc_phandle = fdt.alloc_phandle()
    fdt.prop('phandle', struct.pack('>I', intc_phandle))
    fdt.prop('#interrupt-cells', struct.pack('>I', 1))
    fdt.prop('interrupt-controller', b'')
    fdt.prop('compatible', b'riscv,cpu-intc')
    fdt.end_node()
    fdt.end_node()

    fdt.begin_node('cpu-map')
    fdt.begin_node('cluster0')
    fdt.begin_node('core0')
    fdt.prop('cpu', struct.pack('>I', cpu_phandle))
    fdt.end_node()
    fdt.end_node()
    fdt.end_node()

    fdt.end_node()

    fdt.begin_node(f'memory@{dram_base:08x}')
    fdt.prop('device_type', b'memory')
    fdt.prop('reg', struct.pack('>IIII',
        (dram_base >> 32) & 0xffffffff, dram_base & 0xffffffff,
        (dram_size >> 32) & 0xffffffff, dram_size & 0xffffffff))
    fdt.end_node()

    fdt.begin_node('soc')
    fdt.prop('#address-cells', struct.pack('>I', 2))
    fdt.prop('#size-cells', struct.pack('>I', 2))
    fdt.prop('compatible', b'simple-bus')
    fdt.prop('ranges', b'')

    # CLINT
    fdt.begin_node('clint@2000000')
    fdt.prop('compatible', b'riscv,clint0')
    fdt.prop('reg', struct.pack('>IIII', 0, 0x02000000, 0, 0x00010000))
    fdt.prop('interrupts-extended',
             struct.pack('>II', intc_phandle, 3) +
             struct.pack('>II', intc_phandle, 7))
    fdt.end_node()

    # PLIC - single interrupts-extended prop with both contexts
    fdt.begin_node('plic@c000000')
    plic_phandle = fdt.alloc_phandle()
    fdt.prop('phandle', struct.pack('>I', plic_phandle))
    fdt.prop('#interrupt-cells', struct.pack('>I', 1))
    fdt.prop('interrupt-controller', b'')
    fdt.prop('compatible', b'riscv,plic0')
    fdt.prop('reg', struct.pack('>IIII', 0, 0x0c000000, 0, 0x02000000))
    fdt.prop('riscv,ndev', struct.pack('>I', 31))
    fdt.prop('interrupts-extended',
             struct.pack('>II', intc_phandle, 0x0b) +
             struct.pack('>II', intc_phandle, 0x09))
    fdt.end_node()

    # UART
    fdt.begin_node('serial@10000000')
    uart_phandle = fdt.alloc_phandle()
    fdt.prop('phandle', struct.pack('>I', uart_phandle))
    fdt.prop('compatible', b'ns16550a')
    fdt.prop('reg', struct.pack('>IIII', 0, 0x10000000, 0, 0x00000100))
    fdt.prop('clock-frequency', struct.pack('>I', 1843200))
    fdt.prop('interrupt-parent', struct.pack('>I', plic_phandle))
    fdt.prop('interrupts', struct.pack('>I', 0x0a))
    fdt.end_node()

    fdt.end_node()
    fdt.end_node()
    fdt.end()
    return fdt.build()

if __name__ == '__main__':
    initrd_start = int(sys.argv[1], 0) if len(sys.argv) > 1 else 0
    initrd_end = int(sys.argv[2], 0) if len(sys.argv) > 2 else 0
    data = build_virt_dtb(initrd_start=initrd_start, initrd_end=initrd_end)
    out = 'virt.dtb'
    with open(out, 'wb') as f:
        f.write(data)
    print(f"Wrote {len(data)} bytes -> {out}")
